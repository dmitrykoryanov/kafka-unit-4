    {
      "id": 7,
      "type": "stat",
      "title": "Задержка от источника",
      "description": "Сколько миллисекунд прошло между изменением в PostgreSQL и его обработкой в Debezium для последнего события (MilliSecondsBehindSource). Значение -1 — с момента запуска событий ещё не было.",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(debezium_metrics_milli_seconds_behind_source{instance=~\"$instance\",server=\"$server\",context=\"streaming\"})",
          "legendFormat": "",
          "refId": "A",
          "interval": "",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Событий не было",
                  "color": "blue",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Ошибки",
      "description": "Сумма с момента запуска: неудачные попытки обработки записей в Kafka Connect (total-record-failures), ошибки отправки продюсера (record-error-total) и ошибочные события Debezium (NumberOfErroneousEvents).",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(kafka_connect_task_error_total_record_failures{instance=~\"$instance\",connector=\"$connector\"}) or vector(0)) + (sum(kafka_producer_record_error_total{instance=~\"$instance\",clientId=~\"connector-producer-$connector-.*\"}) or vector(0)) + (sum(debezium_metrics_number_of_erroneous_events{instance=~\"$instance\",server=\"$server\"}) or vector(0))",
          "legendFormat": "",
          "refId": "A",
          "interval": "",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Начальный снимок",
      "description": "Состояние начального снимка таблиц. «Не требовался» — у коннектора уже была сохранённая позиция в журнале, и он продолжил с неё (так бывает после любого перезапуска).",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(debezium_metrics_snapshot_running{instance=~\"$instance\",server=\"$server\",context=\"snapshot\"} == 1) * 1 or max(debezium_metrics_snapshot_aborted{instance=~\"$instance\",server=\"$server\",context=\"snapshot\"} == 1) * 2 or max(debezium_metrics_snapshot_completed{instance=~\"$instance\",server=\"$server\",context=\"snapshot\"} == 1) * 3 or max(debezium_metrics_snapshot_skipped{instance=~\"$instance\",server=\"$server\",context=\"snapshot\"} == 1) * 4 or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "interval": "",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Идёт",
                  "color": "blue",
                  "index": 0
                },
                "2": {
                  "text": "Прерван",
                  "color": "red",
                  "index": 1
                },
                "3": {
                  "text": "Завершён",
                  "color": "green",
                  "index": 2
                },
                "4": {
                  "text": "Не требовался",
                  "color": "green",
                  "index": 3
                },
                "0": {
                  "text": "Нет данных",
                  "color": "orange",
                  "index": 4
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
