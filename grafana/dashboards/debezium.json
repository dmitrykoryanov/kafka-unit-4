      "type": "timeseries",
      "title": "Состояние задач",
      "description": "Число задач коннектора по состояниям.",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(kafka_connect_worker_connector_running_task_count{instance=~\"$instance\",connector=\"$connector\"})",
          "legendFormat": "running",
          "refId": "A",
          "interval": "",
          "exemplar": false
        },
        {
          "expr": "sum(kafka_connect_worker_connector_failed_task_count{instance=~\"$instance\",connector=\"$connector\"})",
          "legendFormat": "failed",
