    {
      "id": 3,
      "type": "stat",
      "title": "Коннектор",
      "description": "Состояние самого коннектора по данным Kafka Connect (connector-metrics, атрибут status).",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(kafka_connect_connector_info{instance=~\"$instance\",connector=\"$connector\",status=\"running\"}) * 1 or max(kafka_connect_connector_info{instance=~\"$instance\",connector=\"$connector\",status=\"paused\"}) * 2 or max(kafka_connect_connector_info{instance=~\"$instance\",connector=\"$connector\",status=\"failed\"}) * 3 or max(kafka_connect_connector_info{instance=~\"$instance\",connector=\"$connector\",status=\"unassigned\"}) * 4 or max(kafka_connect_connector_info{instance=~\"$instance\",connector=\"$connector\",status=\"restarting\"}) * 5 or max(kafka_connect_connector_info{instance=~\"$instance\",connector=\"$connector\",status=\"stopped\"}) * 6 or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "interval": "",
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет данных",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "RUNNING",
                  "color": "green",
                  "index": 0
                },
                "2": {
                  "text": "PAUSED",
                  "color": "yellow",
                  "index": 1
                },
                "3": {
                  "text": "FAILED",
                  "color": "red",
                  "index": 2
                },
                "4": {
                  "text": "UNASSIGNED",
                  "color": "orange",
                  "index": 3
                },
                "5": {
                  "text": "RESTARTING",
                  "color": "orange",
                  "index": 4
                },
                "6": {
                  "text": "STOPPED",
                  "color": "blue",
                  "index": 5
                },
                "0": {
                  "text": "Не запущен",
                  "color": "red",
                  "index": 6
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Задачи в работе",
      "description": "Сколько задач коннектора в состоянии RUNNING. У pg-connector одна задача (tasks.max = 1).",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(kafka_connect_worker_connector_running_task_count{instance=~\"$instance\",connector=\"$connector\"})",
          "legendFormat": "",
